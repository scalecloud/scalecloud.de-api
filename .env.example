# Application environment: local | beta | production
APP_ENV=local

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Public frontend origin used for CORS
FRONTEND_URL=http://localhost:4200

# API hostname for beta/production TLS and trusted-proxy setup
API_DOMAIN=localhost
TRUSTED_PROXY_IP=127.0.0.1

# Authentik OIDC provider
OIDC_ISSUER=https://auth.scalecloud.de/application/o/<provider-slug>/
OIDC_CLIENT_ID=replace-with-provider-client-id

# Authentik Admin API
AUTHENTIK_API_URL=https://auth.scalecloud.de/api/v3/
AUTHENTIK_API_TOKEN=replace-with-server-side-api-token
AUTHENTIK_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# Optional OpenCloud 8.1 integration. Leave all three empty to disable it.
OPENCLOUD_BASE_URL=https://cloud.example.com
OPENCLOUD_USERNAME=svc-billing
OPENCLOUD_APP_TOKEN=replace-with-opencloud-app-token
# Optional role overrides; defaults match OpenCloud 8.1.0.
OPENCLOUD_ROLE_EDITOR=

# MongoDB Atlas X.509 authentication. Base64-encode the combined certificate/private-key PEM.
MONGODB_URI=mongodb+srv://<cluster-host>/?authSource=%24external&authMechanism=MONGODB-X509&appName=<app-name>
MONGODB_TLS_CERT_BASE64=replace-with-base64-encoded-mongodb-pem

# Stripe
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_ENDPOINT_SECRET=whsec_replace-me

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
